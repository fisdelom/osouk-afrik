# PostgreSQL URL from Neon or another hosted PostgreSQL provider.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Set false only for an unencrypted local PostgreSQL instance.
DATABASE_SSL="false"

# Required. Generate a long random value and keep it only in your host's
# environment variables; never commit the real token.
ADMIN_TOKEN="CHANGE_THIS_TO_A_LONG_RANDOM_SECRET"
